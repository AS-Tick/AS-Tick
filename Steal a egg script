-- Background loop for Smart Stealing & Protector Evasion across faces
task.spawn(function()
    while true do
        task.wait(0.5)
        if autoFarmActive and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = player.Character.HumanoidRootPart
            local myBasePos = hrp.Position -- Fallback to current starting point if base position is local
            
            -- Find Rare/OP Eggs across the 10 faces in Workspace
            for _, obj in pairs(Workspace:GetDescendants()) do
                if not autoFarmActive then break end
                local nameLower = obj.Name:lower()
                if (nameLower:find("egg") or nameLower:find("rare") or nameLower:find("op") or nameLower:find("big")) and (obj:IsA("Model") or obj:IsA("Part")) then
                    local targetPart = obj:IsA("Model") and obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") or (obj:IsA("Part") and obj)
                    
                    if targetPart then
                        statusLabel.Text = "Stealing target: " .. obj.Name
                        -- Boost speed temporarily to outrun different face protectors
                        currentSpeed = 180 
                        
                        -- Teleport / Move smoothly to Egg
                        hrp.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
                        task.wait(0.3) -- Grab instant
                        
                        -- Instantly return to base to avoid protector hit
                        -- (If base part exists in workspace for player, we target it, else jump back)
                        local baseModel = Workspace:FindFirstChild(player.Name .. "Base") or Workspace:FindFirstChild("Plots")
                        if baseModel then
                            -- finding base position
                            for _, baseObj in pairs(baseModel:GetDescendants()) do
                                if baseObj:IsA("BasePart") then
                                    hrp.CFrame = baseObj.CFrame + Vector3.new(0, 5, 0)
                                    break
                                end
                            end
                        else
                            -- Safe retreat jump back
                            hrp.CFrame = hrp.CFrame + Vector3.new(0, 5, -20)
                        end
                        
                        statusLabel.Text = "Egg secured at base!"
                        task.wait(1)
                    end
                end
            end
        end
    end
end)

